---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';
import Boton from '../components/ui/Boton.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import CasoClinico from '../components/treatment/CasoClinico.astro';
import Figura from '../components/ui/Figura.astro';
import { esquemaTratamiento } from '../lib/seo';

interface Props {
  tratamiento: CollectionEntry<'tratamientos'>;
}

const { tratamiento } = Astro.props;
const t = tratamiento.data;

const ruta = `/tratamientos/${tratamiento.id}`;
const numero = (i: number) => String(i + 1).padStart(2, '0');

const idsEquipo = new Set(t.especialistas.map((ref) => ref.id));
const equipo = (await getCollection('especialistas', ({ id }) => idsEquipo.has(id))).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const casos = (
  await getCollection('casos', ({ data }) => data.tratamiento.id === tratamiento.id)
).sort((a, b) => a.data.orden - b.data.orden);
---

<Base titulo={t.seo.titulo} descripcion={t.seo.descripcion} ruta={ruta}>
  <JsonLd
    slot="head"
    datos={esquemaTratamiento({ nombre: t.nombre, descripcion: t.seo.descripcion, ruta })}
  />
  <Nav slot="encabezado" ruta={ruta} />

  {/* Cabecera. No usa Seccion: necesita hueco para la barra fija. */}
  <section class="pt-32 pb-seccion-sm md:pt-40">
    <div class="mx-auto max-w-ancho px-6 md:px-10">
      <nav aria-label="Ruta de navegación" class="text-menor text-grafito">
        <a href="/tratamientos" class="objetivo-tactil underline underline-offset-4">Tratamientos</a>
        <span aria-hidden="true" class="px-2">/</span>
        <span>{t.nombre}</span>
      </nav>

      <h1 class="mt-6 max-w-[16ch] text-display">{t.nombre}</h1>
      <p class="mt-5 max-w-[42ch] text-subtitulo text-grafito">{t.titular}</p>
    </div>
  </section>

  {/* 1 · Problema que resuelve */}
  <Seccion ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12">
      <h2 class="text-titulo md:col-span-4">Qué resuelve</h2>

      <div class="md:col-span-7 md:col-start-6">
        <p class="text-cuerpo-lg">{t.problema}</p>

        <ul class="mt-8 border-t border-borde">
          {
            t.atendemos.map((caso) => (
              <li class="border-b border-borde py-4 text-cuerpo">{caso}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </Seccion>

  {/* 2 · Indicaciones */}
  <Seccion tono="franja" ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12">
      <h2 class="text-titulo md:col-span-4">Cuándo se recomienda</h2>
      <p class="text-cuerpo-lg md:col-span-7 md:col-start-6">{t.indicaciones}</p>
    </div>
  </Seccion>

  {/* 3 · Alternativas */}
  <Seccion ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 class="text-titulo">Alternativas</h2>
        <p class="mt-4 max-w-[34ch] text-menor text-grafito">
          Ningún procedimiento es la única opción. La alternativa adecuada se decide
          después de la evaluación, con el paciente informado de todas.
        </p>
      </div>

      <ul class="border-t border-borde md:col-span-7 md:col-start-6">
        {
          t.alternativas.map((alternativa) => (
            <li class="border-b border-borde py-4 text-cuerpo">{alternativa}</li>
          ))
        }
      </ul>
    </div>
  </Seccion>

  {/* 4 · Proceso paso a paso */}
  <Seccion tono="franja">
    <h2 class="text-display">Cómo es el proceso</h2>

    <ol class="mt-12 border-t border-borde">
      {
        t.proceso.map((paso, i) => (
          <li class="grid gap-x-10 gap-y-2 border-b border-borde py-8 md:grid-cols-12">
            <span class="cifra text-titulo text-grafito md:col-span-2">{numero(i)}</span>

            <div class="md:col-span-9 md:col-start-4">
              <h3 class="text-subtitulo">{paso.titulo}</h3>
              <p class="mt-2 max-w-[54ch] text-cuerpo">{paso.descripcion}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Seccion>

  {/* 5 · Beneficios */}
  <Seccion ritmo="corto">
    <div class="max-w-texto">
      <h2 class="text-titulo">Qué busca el tratamiento</h2>
      <p class="mt-5 text-cuerpo-lg">{t.beneficios}</p>
    </div>

    <div class="mt-8 max-w-texto">
      <slot />
    </div>
  </Seccion>

  {/* 6 · Especialista responsable */}
  <Seccion ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12">
      <h2 class="text-titulo md:col-span-4">Quién lo realiza</h2>

      <div class="md:col-span-7 md:col-start-6">
        {t.equipo && <p class="text-cuerpo-lg">{t.equipo}</p>}

        {
          equipo.length > 0 && (
            <ul class="mt-8 border-t border-borde">
              {equipo.map((persona) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-borde py-4">
                  <span class="text-cuerpo">{persona.data.nombre}</span>
                  <span class="cifra text-menor text-grafito">
                    Colegiatura {persona.data.colegiatura}
                  </span>
                </li>
              ))}
            </ul>
          )
        }

        <p class="mt-6 text-menor">
          <a class="enlace" href="/especialistas">Ver el equipo completo</a>
        </p>
      </div>
    </div>
  </Seccion>

  {/* 7 · Tecnología utilizada */}
  {
    t.tecnologia.length > 0 && (
      <Seccion tono="franja" ritmo="corto">
        <div class="grid gap-x-16 gap-y-8 md:grid-cols-12">
          <div class="md:col-span-4">
            <h2 class="text-titulo">Tecnología</h2>
            <p class="mt-4 max-w-[34ch] text-menor text-grafito">
              El equipamiento no decide el tratamiento: da información antes de empezar.
            </p>
          </div>

          <ul class="grid gap-x-10 border-t border-borde md:col-span-7 md:col-start-6 md:grid-cols-2">
            {t.tecnologia.map((equipo) => (
              <li class="border-b border-borde py-4 text-cuerpo">{equipo}</li>
            ))}
          </ul>
        </div>
      </Seccion>
    )
  }

  {/* 8 · Casos clínicos relacionados. Sin casos publicados no se dibuja. */}
  {
    casos.length > 0 && (
      <Seccion ritmo="corto">
        <h2 class="text-titulo">Casos clínicos</h2>
        <div class="mt-10 grid gap-16">
          {casos.map((caso) => (
            <CasoClinico caso={caso} mostrarTratamiento={false} />
          ))}
        </div>
      </Seccion>
    )
  }

  {/* 9 · Fotografía representativa */}
  <Seccion tono="oscuro">
    <div class="grid gap-x-16 gap-y-10 md:grid-cols-12 md:items-end">
      {
        t.foto && t.altFoto ? (
          <Figura
            imagen={t.foto}
            alt={t.altFoto}
            sizes="(min-width: 768px) 58vw, 100vw"
            class="md:col-span-7"
          />
        ) : null
      }

      <div class="md:col-span-4 md:col-start-9">
        {t.cierre && <p class="text-subtitulo">{t.cierre}</p>}

        <div class="mt-8">
          <Boton href="/#reserva">Reservar mi cita</Boton>
        </div>
      </div>
    </div>
  </Seccion>
  <Pie slot="pie" />
</Base>
