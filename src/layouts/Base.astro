---
import { SITIO } from '../config/site';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica sin dominio, por ejemplo "/tratamientos/ortodoncia". */
  ruta?: string;
  noIndexar?: boolean;
}

const { titulo, descripcion = SITIO.descripcion, ruta, noIndexar = false } = Astro.props;

const tituloCompleto = titulo === SITIO.nombre ? titulo : `${titulo} — ${SITIO.nombre}`;
const canonical = Astro.site ? new URL(ruta ?? Astro.url.pathname, Astro.site).href : null;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndexar && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:locale" content={SITIO.locale} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    {canonical && <meta property="og:url" content={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <slot name="head" />
  </head>

  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <slot name="encabezado" />

    <main id="contenido">
      <slot />
    </main>

    <slot name="pie" />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    background-color: var(--color-superficie);
    color: var(--color-tinta);
    border-radius: var(--radius-accion);
    box-shadow: inset 0 0 0 1px var(--color-borde);
  }

  .saltar:focus {
    left: 0.5rem;
    top: 0.5rem;
  }
</style>
