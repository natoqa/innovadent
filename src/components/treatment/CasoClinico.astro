---
import type { CollectionEntry } from 'astro:content';
import FotosCaso from '../casos/FotosCaso.astro';
import DatosCaso from '../casos/DatosCaso.astro';
import RecorridoCaso from '../casos/RecorridoCaso.astro';
import { vistaDeCaso } from '../../lib/casos';

interface Props {
  caso: CollectionEntry<'casos'>;
  /** En la landing el tratamiento ya está en el titular de la página. */
  mostrarTratamiento?: boolean;
}

const { caso, mostrarTratamiento = true } = Astro.props;
const vista = await vistaDeCaso(caso);
---

<article class="grid gap-x-16 gap-y-8 md:grid-cols-12">
  <div class="md:col-span-7">
    <FotosCaso formato={vista.formato} fotos={vista.fotos} titulo={vista.titulo ?? ''} anchoVw={55} />
  </div>

  <div class="md:col-span-5">
    <h3 class="text-subtitulo">{vista.titulo}</h3>
    <div class="mt-6 border-t border-borde">
      <DatosCaso caso={vista} mostrarEspecialidad={mostrarTratamiento} />
    </div>
    <div class="mt-8">
      <RecorridoCaso caso={vista} disposicion="vertical" />
    </div>
  </div>
</article>
