---
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import Figura from '../ui/Figura.astro';
import FotosCaso from '../casos/FotosCaso.astro';
import { casosParaMostrar, describirFormato } from '../../lib/casos';
import { SITIO } from '../../config/site';

// Un caso grande con su ficha y hasta tres más en miniatura. El resto vive en
// /casos-clinicos y en la landing de cada tratamiento. Sin casos publicados, el
// destacado es el de muestra, en gris.
const [destacado, ...resto] = await casosParaMostrar();
const otros = resto.filter((caso) => !caso.muestra).slice(0, 3);

const ficha =
  destacado && !destacado.muestra
    ? [
        { etiqueta: 'Tratamiento', valor: destacado.tratamiento.nombre },
        { etiqueta: 'Especialista', valor: destacado.especialista ?? '' },
        { etiqueta: 'Duración', valor: destacado.duracion ?? '' },
        { etiqueta: 'Registro', valor: describirFormato(destacado.formato, destacado.fotos.length) },
      ].filter((fila) => fila.valor)
    : [];

/** En un antes y después la miniatura es el después; en el resto, la principal. */
const miniatura = (caso: (typeof otros)[number]) =>
  caso.formato === 'antes-despues' ? caso.fotos[1] : caso.fotos[0];
---

<Seccion id="casos-clinicos" tono="oscuro">
  <EncabezadoSeccion
    titulo="Casos que muestran nuestro trabajo."
    entradilla={`${SITIO.aniversario - SITIO.fundacion} años de experiencia clínica, reflejados en casos reales.`}
    sobreOscuro
  />

  <div class="mt-12 md:mt-16">
    {
      destacado && (
        <FotosCaso
          formato={destacado.formato}
          fotos={destacado.fotos}
          titulo={destacado.titulo ?? 'caso pendiente'}
          tono="oscuro"
          anchoVw={95}
          aspecto="aspect-[4/5] md:aspect-video"
        />
      )
    }

    {ficha.length > 0 && (
    <dl class="mt-6 grid grid-cols-1 gap-5 border-t border-tinta-700 pt-5 min-[400px]:grid-cols-2 md:grid-cols-4">
      {
        ficha.map((fila) => (
          <div>
            <dt class="text-dato text-superficie/70">{fila.etiqueta}</dt>
            <dd class="mt-1.5 text-menor">{fila.valor}</dd>
          </div>
        ))
      }
    </dl>
    )}
  </div>

  {
    otros.length > 0 ? (
      <div class="mt-12 grid gap-4 min-[480px]:grid-cols-2 md:mt-16 md:grid-cols-3 md:gap-6">
        {otros.map((caso) => {
          const foto = miniatura(caso);
          return foto?.foto && foto.alt ? (
            <Figura
              imagen={foto.foto}
              alt={foto.alt}
              pie={caso.tratamiento.nombre}
              sizes="(min-width: 768px) 30vw, (min-width: 480px) 50vw, 100vw"
              class="[&_.foto]:aspect-[4/5] [&_figcaption]:text-superficie/70 [&_img]:h-full [&_img]:w-full [&_img]:object-cover"
            />
          ) : null;
        })}
      </div>
    ) : null
  }

  <p class="mt-10 text-menor">
    <a class="enlace objetivo-tactil" href="/casos-clinicos">Ver los casos por especialidad</a>
  </p>
</Seccion>
