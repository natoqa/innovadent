---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import { tamanosRetrato, type Regla } from '../../lib/retrato';

// La home muestra hasta ocho especialistas con retrato, según el `orden` de la
// colección. Quien aún no tiene foto entra solo cuando llegue.
const principales = (await getCollection('especialistas'))
  .filter((persona) => persona.data.retrato)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 8);

// Ancho real de cada columna: 4 en escritorio dentro de max-w-ancho, 2 en móvil.
const COLUMNA: Regla[] = [
  ['(min-width: 1248px)', '17rem'],
  ['(min-width: 768px)', '(25vw - 2.6rem)'],
  ['', '(50vw - 2rem)'],
];
---

<Seccion id="especialistas" ritmo="corto">
  <EncabezadoSeccion
    titulo="Un equipo que hace la diferencia."
    entradilla="Especialistas en distintas áreas que trabajan de manera coordinada para construir el plan de tratamiento que cada paciente necesita."
    medida="16ch"
  />

  <ul data-mov="grupo" class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-16 md:grid-cols-4 md:gap-x-7">
    {
      principales.map((persona, i) => (
        <li
          class:list={[i % 2 === 1 && 'mt-8 md:mt-14']}
          data-mov={i % 2 === 1 ? 'profundidad' : undefined}
          data-mov-intensidad="30"
        >
          <article>
            <div class="foto aspect-[3/4] bg-tinta-800">
              {persona.data.retrato ? (
                <Picture
                  src={persona.data.retrato}
                  alt={`Retrato de ${persona.data.nombre}.`}
                  formats={['avif', 'webp']}
                  widths={[400, 600, 800, 1200]}
                  sizes={tamanosRetrato(persona.data.retrato, 3 / 4, COLUMNA)}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class="flex h-full items-end p-4">
                </div>
              )}
            </div>

            <h3 class="mt-4 text-subtitulo">{persona.data.nombre}</h3>
            <p class="mt-1 text-menor text-grafito">{persona.data.especialidad}</p>
            <p class="mt-1 text-dato text-grafito">
              Colegiatura <span class="cifra">{persona.data.colegiatura}</span>
            </p>
          </article>
        </li>
      ))
    }
  </ul>

  <p class="mt-12 text-menor">
    <a class="enlace" href="/especialistas">Conoce a nuestros especialistas</a>
  </p>
</Seccion>
