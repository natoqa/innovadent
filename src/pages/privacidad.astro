---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';

export const prerender = true;

/**
 * El texto legal lo redacta y firma la clínica: responsable del banco de
 * datos, su inscripción ante la ANPDP, finalidades, destinatarios y cómo
 * ejercer los derechos ARCO. Aquí no se redacta por aproximación.
 */
---

<Base titulo="Política de privacidad" ruta="/privacidad" noIndexar>
  <Nav slot="encabezado" />

  <Seccion ancho="texto" class="pt-40">
    <h1 class="text-display">Política de privacidad</h1>

    <p class="mt-8 text-cuerpo-lg">
      [PENDIENTE: texto de la política de privacidad conforme a la Ley 29733, redactado y
      aprobado por la clínica.]
    </p>

    <p class="mt-6 text-grafito">
      [PENDIENTE: debe cubrir el responsable del banco de datos y su inscripción, la
      finalidad del tratamiento, la transferencia al sistema de gestión de pacientes, el
      plazo de conservación y cómo ejercer los derechos de acceso, rectificación,
      cancelación y oposición.]
    </p>
  </Seccion>

  <Pie slot="pie" />
</Base>
