---
import { getCollection } from 'astro:content';
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import EspacioFoto from '../ui/EspacioFoto.astro';
import Boton from '../ui/Boton.astro';
import { CATEGORIAS, type ClaveCategoria } from '../../lib/tecnologia';
import fotoDiagnostico from '../../assets/diagnostico.jpg';
import fotoPlanificacion from '../../assets/planificacion.jpg';
import fotoSeguridad from '../../assets/seguridad.jpg';
import fotoTratamiento from '../../assets/tratamiento.jpg';

const fotos = {
  diagnostico: {
    imagen: fotoDiagnostico,
    alt: 'Una especialista señala en una pantalla la radiografía panorámica de un paciente mientras se la explica.',
  },
  planificacion: {
    imagen: fotoPlanificacion,
    alt: 'Dos especialistas de la clínica revisan juntos una ficha en el pasillo de los consultorios.',
  },
  tratamiento: {
    imagen: fotoTratamiento,
    alt: 'Un especialista con guantes y mascarilla atiende a una paciente recostada en el sillón dental.',
  },
  seguridad: {
    imagen: fotoSeguridad,
    alt: 'Un especialista le muestra a una paciente un modelo dental con brackets durante la consulta.',
  },
} satisfies Record<ClaveCategoria, { imagen: ImageMetadata; alt: string }>;

const categorias = CATEGORIAS.map((categoria) => ({ ...categoria, foto: fotos[categoria.clave] }));

const equipos = (await getCollection('tecnologia')).sort((a, b) => a.data.orden - b.data.orden);

/**
 * Las filas alternan el lado de la foto para que cuatro categorías seguidas no
 * se lean como la misma fila repetida. Con equipos cargados, solo aparecen las
 * categorías que tienen alguno.
 *
 * Sin equipos se dibuja la maqueta: barras donde irán el beneficio, el equipo
 * y la marca.
 */
const maqueta = equipos.length === 0;

const grupos = categorias
  .map((categoria) => ({
    ...categoria,
    equipos: equipos.filter((equipo) => equipo.data.categoria === categoria.clave),
  }))
  .filter((grupo) => maqueta || grupo.equipos.length > 0);
---

<Seccion id="tecnologia">
  <EncabezadoSeccion
    titulo="Con qué trabajamos."
    entradilla="Contado por lo que cambia para ti durante la consulta, no por la ficha técnica."
  />

  <div class="mt-12 border-t border-tinta md:mt-16" data-mov="filas">
    {
      grupos.map((grupo, i) => (
        <div class="grid gap-x-10 gap-y-8 border-b border-borde py-10 md:grid-cols-12 md:py-12">
          <div class="md:col-span-3">
            <h3 class="text-titulo">{grupo.nombre}</h3>
            <p class="mt-3 max-w-[28ch] text-menor text-grafito">{grupo.nota}</p>
          </div>

          <div class="grid gap-x-10 gap-y-6 sm:grid-cols-9 md:col-span-9">
            <EspacioFoto
              imagen={grupo.foto.imagen}
              alt={grupo.foto.alt}
              descripcion="Foto del equipo, tomada en la clínica."
              sizes="(min-width: 768px) 30vw, 100vw"
              aspecto={i % 2 === 0 ? 'aspect-[4/3]' : 'aspect-[16/10]'}
              class={i % 2 === 0 ? 'sm:col-span-4' : 'sm:order-2 sm:col-span-5'}
            />

            {maqueta ? (
              <div class={i % 2 === 0 ? 'sm:col-span-5' : 'sm:col-span-4'} aria-hidden="true">
                <span class="grid gap-3 text-subtitulo">
                  <span class="relleno w-full" />
                  <span class="relleno w-3/5" />
                </span>
                <p class="mt-3 text-dato text-grafito">Beneficio para el paciente</p>

                <dl class="mt-6 border-t border-borde text-menor">
                  {['Equipo', 'Marca'].map((etiqueta) => (
                    <div class="flex items-center justify-between gap-6 border-b border-borde py-3">
                      <dt class="text-grafito">{etiqueta}</dt>
                      <dd class="relleno w-32" />
                    </div>
                  ))}
                </dl>
              </div>
            ) : (
              <ul class:list={['grid content-start gap-8', i % 2 === 0 ? 'sm:col-span-5' : 'sm:col-span-4']}>
                {grupo.equipos.map((equipo) => (
                  <li class="max-w-[46ch]">
                    <p class="text-cuerpo-lg">{equipo.data.beneficio}</p>
                    <p class="mt-2 text-menor text-grafito">
                      {equipo.data.marca ? `${equipo.data.equipo}, ${equipo.data.marca}` : equipo.data.equipo}
                    </p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-10 md:mt-12">
    <Boton href="/instalaciones" variante="secundaria">Ver equipos e instalaciones</Boton>
  </div>
</Seccion>
