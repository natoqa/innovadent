---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';
import Ficha from '../components/ui/Ficha.astro';
import Boton from '../components/ui/Boton.astro';
import { SITIO } from '../config/site';

export const prerender = true;

const especialistas = (await getCollection('especialistas')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const tratamientos = (await getCollection('tratamientos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);

/**
 * El cliente separa asistentes de apoyos, y recepción de administración. Para
 * el paciente esa diferencia interna no significa nada: lo que le importa es
 * quién le asiste en el sillón y quién le atiende en el mostrador.
 */
const bloques = [
  {
    titulo: 'Equipo asistencial',
    nota: 'No realizan tratamientos. Acompañan al especialista durante la atención.',
    personas: equipo.filter((p) => p.data.grupo === 'asistentes' || p.data.grupo === 'apoyos'),
  },
  {
    titulo: 'Recepción y administración',
    personas: equipo.filter(
      (p) => p.data.grupo === 'recepcion' || p.data.grupo === 'administracion',
    ),
  },
].filter((bloque) => bloque.personas.length > 0);

/** Cuando la formación y la función son la misma palabra, no se repite. */
const funcionDe = (persona: (typeof equipo)[number]) =>
  persona.data.titulo.toLowerCase() === persona.data.rol.toLowerCase()
    ? persona.data.rol
    : `${persona.data.rol}, ${persona.data.titulo.toLowerCase()}`;

/** Las áreas de cada profesional se leen del tratamiento, que es donde se declaran. */
const areasDe = (slug: string) =>
  tratamientos.filter((t) => t.data.especialistas.some((ref) => ref.id === slug));

const filasDe = (persona: (typeof especialistas)[number]) => [
  { etiqueta: 'Título', valor: persona.data.titulo },
  { etiqueta: 'Especialidad', valor: persona.data.especialidad },
  { etiqueta: 'Colegiatura', valor: persona.data.colegiatura },
  ...(persona.data.rne ? [{ etiqueta: 'RNE', valor: persona.data.rne }] : []),
];
---

<Base
  titulo={`Especialistas en ${SITIO.sede.ciudad}`}
  descripcion="El equipo de Innovadent: cirujanos dentistas colegiados, con su especialidad y su número de colegiatura."
  ruta="/especialistas"
>
  <Nav slot="encabezado" ruta="/especialistas" />

  <section class="pt-32 pb-seccion-sm md:pt-40">
    <div class="mx-auto max-w-ancho px-6 md:px-10">
      <h1 class="max-w-[16ch] text-display">
        {especialistas.length} especialistas, con nombre y colegiatura.
      </h1>

      <p class="mt-6 max-w-[46ch] text-cuerpo-lg text-grafito">
        Todo tratamiento lo realiza un cirujano dentista colegiado. Publicamos el número
        de colegiatura de cada uno para que cualquier paciente pueda comprobarlo.
      </p>
    </div>
  </section>

  <Seccion ritmo="corto">
    <div class="border-t border-borde">
      {
        especialistas.map((persona) => {
          const areas = areasDe(persona.id);

          return (
            <article class="grid gap-x-16 gap-y-8 border-b border-borde py-10 md:grid-cols-12 md:py-14">
              <div class="foto aspect-[3/4] bg-tinta-800 md:col-span-4">
                <div class="flex h-full items-end p-4">
                  <span class="text-dato text-superficie">[PENDIENTE: retrato]</span>
                </div>
              </div>

              <div class="md:col-span-7 md:col-start-6">
                <h2 class="text-titulo">{persona.data.nombre}</h2>
                <p class="mt-3 text-cuerpo-lg text-grafito">{persona.data.especialidad}</p>

                <div class="mt-8 max-w-[34rem]">
                  <Ficha filas={filasDe(persona)} titulo={`Datos de ${persona.data.nombre}`} />
                </div>

                {areas.length > 0 && (
                  <div class="mt-8">
                    <p class="text-dato text-grafito">Atiende en</p>

                    <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
                      {areas.map((area) => (
                        <li>
                          <a class="objetivo-tactil enlace text-menor" href={`/tratamientos/${area.id}`}>
                            {area.data.nombre}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    <p class="mt-10 max-w-texto text-menor text-grafito">
      [PENDIENTE: retratos del equipo y formación de cada especialista: universidad,
      posgrado y sociedades a las que pertenece. Hasta tenerlo por escrito, la ficha
      solo muestra lo que el cliente confirmó.]
    </p>
  </Seccion>

  {
    bloques.length > 0 && (
      <Seccion tono="franja" ritmo="corto">
        {bloques.map((bloque, i) => (
          <div class:list={['grid gap-x-16 gap-y-8 md:grid-cols-12', i > 0 && 'mt-14']}>
            <div class="md:col-span-4">
              <h2 class="text-titulo">{bloque.titulo}</h2>

              {bloque.nota && (
                <p class="mt-4 max-w-[34ch] text-menor text-grafito">{bloque.nota}</p>
              )}
            </div>

            <ul class="border-t border-borde md:col-span-7 md:col-start-6">
              {bloque.personas.map((persona) => (
                <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-borde py-4">
                  <span class="text-cuerpo">{persona.data.nombre}</span>
                  <span class="text-menor text-grafito">{funcionDe(persona)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </Seccion>
    )
  }

  <Seccion tono="oscuro" ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12 md:items-end">
      <p class="text-subtitulo md:col-span-6">
        La evaluación decide qué especialidad interviene. Puedes empezar por ahí.
      </p>

      <div class="md:col-span-4 md:col-start-9">
        <Boton href="/#reserva">Reservar mi cita</Boton>
      </div>
    </div>
  </Seccion>
  <Pie slot="pie" />
</Base>
