---
import { getCollection } from 'astro:content';
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import { SITIO } from '../../config/site';

const testimonios = (await getCollection('testimonios')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

// La valoración se muestra solo si está copiada de la ficha real, completa.
const { ficha, valoracion, resenas } = SITIO.google;
const google =
  ficha && valoracion !== null && resenas !== null
    ? {
        ficha,
        valoracion: new Intl.NumberFormat(SITIO.idioma, { maximumFractionDigits: 1 }).format(valoracion),
        resenas: new Intl.NumberFormat(SITIO.idioma).format(resenas),
      }
    : null;

/**
 * Los videos se graban en vertical y van en una fila de tres. Mientras falten,
 * los huecos se dibujan en gris para revisar la composición con el cliente.
 * Ninguna cita se inventa.
 */
const ESPACIOS_VIDEO = 3;

const videos = testimonios.filter((t) => t.data.video);
const textos = testimonios.filter((t) => !t.data.video);
const huecos = Math.max(ESPACIOS_VIDEO - videos.length, 0);
const maqueta = testimonios.length === 0;

/** Sin portada, `#t=0.1` hace que el navegador pinte un cuadro y no un rectángulo negro. */
const fuente = (video: string, poster?: string) => (poster ? video : `${video}#t=0.1`);
---

<Seccion id="testimonios" tono="oscuro" ritmo="corto">
  <EncabezadoSeccion
    titulo="Lo que cuentan los pacientes."
    entradilla="Con su nombre o sus iniciales, y con su autorización para publicarlo."
    sobreOscuro
  />

  <!-- En móvil la fila se desliza de lado: tres videos verticales apilados
       serían tres pantallas de alto. -->
  <ul
    class="testimonios-fila -mx-6 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-2 md:mx-0 md:mt-16 md:grid md:grid-cols-3 md:gap-8 md:overflow-visible md:px-0 md:pb-0"
    data-mov-fotos
  >
    {
      videos.map((testimonio) => (
        <li class="w-[72vw] max-w-80 shrink-0 snap-start md:w-auto md:max-w-none">
          <figure>
            <div class="foto aspect-[9/16] bg-tinta-700">
              <video
                src={fuente(testimonio.data.video!, testimonio.data.poster)}
                poster={testimonio.data.poster}
                controls
                preload={testimonio.data.poster ? 'none' : 'metadata'}
                playsinline
                class="h-full w-full object-cover"
                aria-label={
                  testimonio.data.autor
                    ? `Testimonio en video de ${testimonio.data.autor}`
                    : 'Testimonio en video de un paciente'
                }
              />
            </div>
            {(testimonio.data.texto || testimonio.data.autor) && (
              <figcaption class="mt-5">
                {testimonio.data.texto && (
                  <blockquote class="text-cuerpo-lg">
                    <p>{testimonio.data.texto}</p>
                  </blockquote>
                )}
                {testimonio.data.autor && (
                  <span class:list={['block text-menor', testimonio.data.texto && 'mt-3']}>
                    {testimonio.data.autor}
                  </span>
                )}
              </figcaption>
            )}
          </figure>
        </li>
      ))
    }

    {
      Array.from({ length: huecos }, () => (
        <li class="w-[72vw] max-w-80 shrink-0 snap-start md:w-auto md:max-w-none" aria-hidden="true">
          <div class="foto relative flex aspect-[9/16] items-end bg-tinta-700 p-5">
            <span class="absolute top-1/2 left-1/2 flex size-14 -translate-1/2 items-center justify-center rounded-full bg-superficie/90">
              <svg width="16" height="18" viewBox="0 0 18 20" fill="none">
                <path d="M17 10L1 19V1L17 10Z" fill="var(--color-tinta)" />
              </svg>
            </span>
            <p class="max-w-[24ch] text-dato text-superficie/70">
              Video vertical de un paciente contando su experiencia.
            </p>
          </div>
          <span class="mt-5 block text-menor">
            <span class="relleno w-20" />
          </span>
        </li>
      ))
    }
  </ul>

  {
    textos.length > 0 && (
      <div class="mt-14 grid gap-10 md:grid-cols-2 md:gap-16">
        {textos.map((testimonio) => (
          <figure class="border-t border-tinta-700 pt-8">
            <blockquote class="text-subtitulo">
              <p data-mov="palabras">{testimonio.data.texto}</p>
            </blockquote>
            {testimonio.data.autor && (
              <figcaption class="mt-4 text-menor">{testimonio.data.autor}</figcaption>
            )}
          </figure>
        ))}
      </div>
    )
  }

  {
    google ? (
      <p class="cifra mt-14 border-t border-tinta-700 pt-8 text-cuerpo-lg">
        <a class="enlace" href={google.ficha} target="_blank" rel="noopener">
          {google.valoracion} de 5 en Google, con {google.resenas} reseñas
        </a>
      </p>
    ) : (
      maqueta && (
        <div class="mt-14 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-tinta-700 pt-8" aria-hidden="true">
          <span class="relleno h-[1.4em] w-14 text-titulo" />
          <span class="text-menor text-superficie/70">Valoración en Google y número de reseñas, copiados de la ficha real.</span>
        </div>
      )
    )
  }
</Seccion>

<script>
  // Un solo testimonio sonando a la vez.
  const videos = document.querySelectorAll<HTMLVideoElement>('#testimonios video');

  videos.forEach((video) => {
    video.addEventListener('play', () => {
      videos.forEach((otro) => {
        if (otro !== video) otro.pause();
      });
    });
  });
</script>

<style>
  .testimonios-fila {
    scrollbar-width: none;
  }
</style>
