---
import { getCollection } from 'astro:content';
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import { SITIO } from '../../config/site';

// Los hitos sin año confirmado van al final, en su propio bloque: no se les
// inventa una fecha para que encajen en la secuencia.
const todos = await getCollection('hitos');
const fechados = todos
  .filter((hito) => hito.data.anio !== null)
  .sort((a, b) => (a.data.anio ?? 0) - (b.data.anio ?? 0));
const sinFecha = todos.filter((hito) => hito.data.anio === null);
---

<Seccion id="linea-de-tiempo">
  <EncabezadoSeccion
    titulo="Veinte años, contados en orden."
    entradilla={`De una consulta en ${SITIO.sede.ciudad} a un centro con seis especialidades.`}
    medida="12ch"
  />

  <div class="mt-12 border-t border-borde md:mt-16">
    {
      fechados.map((hito) => (
        <article class="grid gap-x-10 gap-y-3 border-b border-borde py-8 md:grid-cols-12">
          <p class="cifra text-display md:col-span-4">{hito.data.anio}</p>

          <div class="md:col-span-7 md:col-start-6 md:self-center">
            <h3 class="text-subtitulo">{hito.data.titular}</h3>
            <p class="mt-2 max-w-[42ch] text-menor text-grafito">{hito.data.descripcion}</p>
          </div>
        </article>
      ))
    }
  </div>

  {
    sinFecha.length > 0 && (
      <div class="mt-10 max-w-texto">
        <h3 class="text-subtitulo">Reconocimientos y presencia en la región</h3>

        <ul class="mt-4">
          {sinFecha.map((hito) => (
            <li class="border-b border-borde py-4">
              <span class="block text-cuerpo">{hito.data.titular}</span>
              <span class="mt-1 block text-menor text-grafito">{hito.data.descripcion}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Seccion>
