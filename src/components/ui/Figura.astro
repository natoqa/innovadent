---
import { Picture } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  /** Describe el contenido clínico real. Nunca vacío en fotos de contenido. */
  alt: string;
  pie?: string;
  /** Solo la imagen del hero. Desactiva lazy y sube la prioridad de carga. */
  prioritaria?: boolean;
  anchos?: number[];
  sizes?: string;
  /** Proporción del recorte, como clase de Tailwind. Sin ella, la de la foto. */
  aspecto?: string;
  /** Fotos con mucho grano, como las de Kids, admiten menos sin que se note. */
  calidad?: number;
  class?: string;
}

// Sin anchos, Astro sirve una sola copia al tamaño original de la foto.
const {
  imagen,
  alt,
  pie,
  prioritaria = false,
  anchos = [480, 800, 1200, 1600],
  sizes,
  aspecto,
  calidad = 65,
  class: clase,
} = Astro.props;
---

<figure class:list={[clase]}>
  <div class:list={['foto', aspecto]}>
    <Picture
      src={imagen}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={calidad}
      widths={anchos}
      sizes={sizes}
      loading={prioritaria ? 'eager' : 'lazy'}
      decoding={prioritaria ? 'sync' : 'async'}
      fetchpriority={prioritaria ? 'high' : 'auto'}
      class:list={[aspecto && 'h-full w-full object-cover']}
    />
  </div>

  {pie && <figcaption class="text-menor text-grafito mt-3">{pie}</figcaption>}
</figure>
