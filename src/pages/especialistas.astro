---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';
import Boton from '../components/ui/Boton.astro';
import FichaEspecialista from '../components/ui/FichaEspecialista.astro';
import { SITIO } from '../config/site';

export const prerender = true;

const especialistas = (await getCollection('especialistas')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const tratamientos = (await getCollection('tratamientos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

const equipo = (await getCollection('equipo')).sort((a, b) => a.data.orden - b.data.orden);

/**
 * El cliente separa asistentes de apoyos, y recepción de administración. Para
 * el paciente esa diferencia interna no significa nada: lo que le importa es
 * quién le asiste en el sillón y quién le atiende en el mostrador.
 */
const bloques = [
  {
    titulo: 'Equipo asistencial',
    nota: 'No realizan tratamientos. Acompañan al especialista durante la atención.',
    personas: equipo.filter((p) => p.data.grupo === 'asistentes' || p.data.grupo === 'apoyos'),
  },
  {
    titulo: 'Recepción y administración',
    personas: equipo.filter(
      (p) => p.data.grupo === 'recepcion' || p.data.grupo === 'administracion',
    ),
  },
].filter((bloque) => bloque.personas.length > 0);

/** Cuando la formación y la función son la misma palabra, no se repite. */
const funcionDe = (persona: (typeof equipo)[number]) =>
  persona.data.titulo.toLowerCase() === persona.data.rol.toLowerCase()
    ? persona.data.rol
    : `${persona.data.rol}, ${persona.data.titulo.toLowerCase()}`;

/** Las áreas de cada profesional se leen del tratamiento, que es donde se declaran. */
const areasDe = (slug: string) =>
  tratamientos.filter((t) => t.data.especialistas.some((ref) => ref.id === slug));

/**
 * El paciente llega con una necesidad, no con un nombre: el filtro ofrece solo
 * las especialidades que tienen al menos un profesional asignado.
 */
const filtros = tratamientos.filter((t) => t.data.especialistas.length > 0);

// Cifras que salen de la propia colección: se pueden comprobar una por una.
const conRne = especialistas.filter((p) => p.data.rne).length;
const cifras = [
  { valor: especialistas.length, texto: 'cirujanos dentistas colegiados' },
  { valor: filtros.length, texto: 'especialidades en una misma sede' },
  ...(conRne > 0 ? [{ valor: conRne, texto: 'con Registro Nacional de Especialista' }] : []),
];
---

<Base
  titulo={`Especialistas en ${SITIO.sede.ciudad}`}
  descripcion="El equipo de Innovadent: cirujanos dentistas colegiados, con su especialidad y su número de colegiatura."
  ruta="/especialistas"
>
  <Nav slot="encabezado" ruta="/especialistas" />

  <section class="pt-32 pb-seccion-sm md:pt-40">
    <div class="mx-auto grid max-w-ancho gap-x-16 gap-y-12 px-6 md:grid-cols-12 md:px-10">
      <h1 class="max-w-[15ch] text-display md:col-span-7">Detrás de cada tratamiento hay un nombre y una colegiatura.</h1>

      <div class="border-l border-tinta pl-6 md:col-span-4 md:col-start-9 md:mt-3">
        <p class="text-cuerpo-lg">
          Todo tratamiento lo realiza un cirujano dentista colegiado.
        </p>
        <p class="mt-4 text-cuerpo text-grafito">
          Publicamos el número de colegiatura de cada uno para que cualquier paciente
          pueda comprobarlo en el Colegio Odontológico del Perú.
        </p>
      </div>

      <dl class="grid grid-cols-3 gap-4 border-t border-borde pt-5 md:col-span-7">
        {
          cifras.map((cifra) => (
            <div>
              <dt class="sr-only">{cifra.texto}</dt>
              <dd>
                <span class="cifra block text-titulo">{cifra.valor}</span>
                <span class="mt-1 block text-dato text-grafito">{cifra.texto}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Seccion ritmo="corto">
    {/* Pestañas. Sin JavaScript no aparecen y se ven los dos grupos seguidos. */}
    <div class="flex justify-center" data-pestanas hidden>
      <div class="flex gap-8" role="tablist" aria-label="Equipo">
        <button type="button" role="tab" id="tab-especialistas" aria-controls="panel-especialistas" aria-selected="true" class="pestana">
          Especialistas
        </button>
        {
          bloques.length > 0 && (
            <button type="button" role="tab" id="tab-apoyo" aria-controls="panel-apoyo" aria-selected="false" tabindex="-1" class="pestana">
              Equipo de apoyo
            </button>
          )
        }
      </div>
    </div>

    <div id="panel-especialistas" role="tabpanel" aria-labelledby="tab-especialistas" class="mt-12">
      <h2 class="sr-only">Especialistas</h2>

      <div class="filtro mb-14" data-filtro hidden>
        <p id="filtro-titulo" class="text-dato text-grafito">Ver especialistas en</p>
        <div
          class="-mx-6 mt-3 flex gap-2 overflow-x-auto px-6 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0"
          role="group"
          aria-labelledby="filtro-titulo"
        >
          <button type="button" class="chip" data-area="" aria-pressed="true">Todo el equipo</button>
          {
            filtros.map((area) => (
              <button type="button" class="chip" data-area={area.id} aria-pressed="false">
                {area.data.nombre}
              </button>
            ))
          }
        </div>
        <p class="sr-only" aria-live="polite" data-filtro-estado></p>
      </div>

      {/* Dos columnas escalonadas. En escritorio la izquierda se desplaza más
          rápido que la derecha al hacer scroll. */}
      <ul class="grilla mx-auto grid max-w-[56rem] grid-cols-2 gap-x-5 gap-y-16 md:gap-x-24 md:gap-y-28" data-grilla>
        {
          especialistas.map((persona, i) => (
            <li
              class="retrato"
              data-persona={persona.id}
              data-areas={areasDe(persona.id).map((area) => area.id).join(' ')}
              data-lado={i % 2 === 0 ? 'izq' : 'der'}
            >
              <button
                type="button"
                class="retrato-boton block w-full text-left"
                aria-haspopup="dialog"
                aria-controls={`ficha-${persona.id}`}
                data-abrir={persona.id}
              >
                <span class="retrato-foto foto relative block aspect-[4/5]">
                  {persona.data.retrato ? (
                    <Picture
                      src={persona.data.retrato}
                      alt={`Retrato de ${persona.data.nombre}.`}
                      formats={['avif', 'webp']}
                      fallbackFormat="jpg"
                      widths={[360, 560, 800]}
                      sizes="(min-width: 1024px) 26rem, 45vw"
                      loading={i < 2 ? 'eager' : 'lazy'}
                      class="h-full w-full object-cover object-[50%_22%]"
                    />
                  ) : (
                    <span class="flex h-full items-end p-4 text-dato text-grafito">
                      Retrato de {persona.data.nombre}.
                    </span>
                  )}
                  <span class="signo" aria-hidden="true" />
                </span>

                <span class="mt-5 block">
                  {persona.data.cargo && (
                    <span class="mb-1 block text-dato text-verde-700">{persona.data.cargo}</span>
                  )}
                  <span class="retrato-nombre block hyphens-none">{persona.data.nombre}</span>
                  <span class="mt-1.5 block text-menor text-grafito">{persona.data.especialidad}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    {
      bloques.length > 0 && (
        <div id="panel-apoyo" role="tabpanel" aria-labelledby="tab-apoyo" class="mt-24" data-panel-apoyo>
          <h2 class="text-titulo" data-titulo-apoyo>Equipo de apoyo</h2>

          {bloques.map((bloque) => (
            <div class="mt-12 grid gap-x-16 gap-y-8 md:grid-cols-12">
              <div class="md:col-span-4">
                <h3 class="text-subtitulo">{bloque.titulo}</h3>
                {bloque.nota && <p class="mt-4 max-w-[34ch] text-menor text-grafito">{bloque.nota}</p>}
              </div>

              <ul class="border-t border-tinta md:col-span-7 md:col-start-6">
                {bloque.personas.map((persona) => (
                  <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1 border-b border-borde py-5">
                    <span class="text-cuerpo-lg">{persona.data.nombre}</span>
                    <span class="text-menor text-grafito">{funcionDe(persona)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </Seccion>

  <Seccion tono="oscuro" ritmo="corto">
    <div class="grid gap-x-16 gap-y-8 md:grid-cols-12 md:items-end">
      <p class="text-subtitulo md:col-span-6">
        La evaluación decide qué especialidad interviene. Puedes empezar por ahí.
      </p>

      <div class="md:col-span-4 md:col-start-9">
        <Boton href="/#reserva">Reservar mi cita</Boton>
      </div>
    </div>
  </Seccion>

  {/* Una ficha por especialista. <dialog> atrapa el foco y cierra con Escape. */}
  {
    especialistas.map((persona) => (
      <dialog id={`ficha-${persona.id}`} class="ficha-panel zona-oscura" aria-labelledby={`nombre-${persona.id}`}>
        <div class="mx-auto max-w-ancho px-6 py-6 md:px-10 md:py-10">
          <div class="flex justify-end">
            <button type="button" class="cerrar" data-cerrar>
              <span class="sr-only">Cerrar la ficha de {persona.data.nombre}</span>
            </button>
          </div>

          <div class="mt-6 grid gap-x-16 gap-y-10 md:grid-cols-12">
            <div class="foto aspect-[4/5] bg-tinta-700 md:col-span-5">
              {persona.data.retrato ? (
                <Picture
                  src={persona.data.retrato}
                  alt={`Retrato de ${persona.data.nombre}.`}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 720, 960]}
                  sizes="(min-width: 768px) 38vw, 100vw"
                  loading="lazy"
                  class="h-full w-full object-cover object-[50%_22%]"
                />
              ) : (
                <span class="flex h-full items-end p-5 text-dato">Retrato de {persona.data.nombre}.</span>
              )}
            </div>

            <div class="md:col-span-6 md:col-start-7 md:pt-4">
              {persona.data.cargo && <p class="text-menor text-verde-200">{persona.data.cargo}</p>}
              <h2 id={`nombre-${persona.id}`} class="mt-2 max-w-[16ch] text-titulo hyphens-none">
                {persona.data.nombre}
              </h2>
              <p class="mt-3 text-cuerpo-lg">{persona.data.especialidad}</p>

              {persona.data.formacion.length > 0 && (
                <div class="mt-10">
                  <h3 class="text-cuerpo font-semibold">Formación</h3>
                  <ul class="mt-3 border-t border-tinta-700">
                    {persona.data.formacion.map((linea) => (
                      <li class="border-b border-tinta-700 py-3 text-menor">{linea}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="mt-10">
                <FichaEspecialista persona={persona} areas={areasDe(persona.id)} />
              </div>
            </div>
          </div>
        </div>
      </dialog>
    ))
  }
  <Pie slot="pie" />
</Base>

<style>
  .retrato[hidden] {
    display: none;
  }

  /* Escalonado: la columna derecha arranca más abajo. Usa `translate`, no
     `transform`, para no pisar el parallax de la izquierda. */
  .retrato[data-lado='der'] {
    translate: 0 3rem;
  }

  @media (min-width: 64rem) {
    .retrato[data-lado='der'] {
      translate: 0 9rem;
    }

    .grilla {
      padding-bottom: 9rem;
    }
  }

  .retrato-nombre {
    font-family: var(--font-display);
    font-size: var(--text-cuerpo-lg);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-tinta);
  }

  @media (min-width: 48rem) {
    .retrato-nombre {
      font-size: var(--text-subtitulo);
    }
  }

  .retrato-foto {
    background-color: var(--color-franja);
  }

  .retrato-foto :global(img) {
    transition: scale 500ms var(--ease-salida);
  }

  /* Botón redondo de la esquina: un más que gira al pasar por encima. */
  .signo {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--color-superficie);
    transition: rotate 240ms var(--ease-salida), background-color var(--duracion-ui) var(--ease-salida);
  }

  .signo::before,
  .signo::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.875rem;
    height: 1.5px;
    background-color: var(--color-tinta);
    translate: -50% -50%;
  }

  .signo::after {
    rotate: 90deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .retrato-boton:hover .retrato-foto :global(img) {
      scale: 1.03;
    }

    .retrato-boton:hover .signo {
      rotate: 90deg;
      background-color: var(--color-verde);
    }
  }

  .retrato-boton:active .signo {
    scale: 0.94;
  }

  @media (prefers-reduced-motion: reduce) {
    .retrato-boton:hover .retrato-foto :global(img) {
      scale: 1;
    }

    .retrato-boton:hover .signo {
      rotate: 0deg;
    }
  }

  /* --- Pestañas ------------------------------------------------------------ */

  .pestana {
    min-height: 3rem;
    font-size: var(--text-cuerpo-lg);
    color: var(--color-grafito);
    border-bottom: 1.5px solid transparent;
    transition:
      color var(--duracion-ui) var(--ease-salida),
      border-color var(--duracion-ui) var(--ease-salida);
  }

  .pestana[aria-selected='true'] {
    color: var(--color-tinta);
    border-color: var(--color-tinta);
  }

  @media (hover: hover) and (pointer: fine) {
    .pestana:hover {
      color: var(--color-tinta);
    }
  }

  [role='tabpanel'][hidden] {
    display: none;
  }

  /* --- Filtro -------------------------------------------------------------- */

  .chip {
    flex: none;
    min-height: 3rem;
    padding: 0 1.125rem;
    border: 1px solid var(--color-borde);
    border-radius: var(--radius-accion);
    font-size: var(--text-menor);
    color: var(--color-tinta);
    white-space: nowrap;
    transition:
      background-color var(--duracion-ui) var(--ease-salida),
      color var(--duracion-ui) var(--ease-salida),
      border-color var(--duracion-ui) var(--ease-salida);
  }

  .chip[aria-pressed='true'] {
    background-color: var(--color-tinta);
    border-color: var(--color-tinta);
    color: var(--color-superficie);
  }

  @media (hover: hover) and (pointer: fine) {
    .chip[aria-pressed='false']:hover {
      background-color: var(--color-franja);
    }
  }

  .chip:active {
    transform: scale(0.97);
  }

  /* --- Ficha a pantalla completa ------------------------------------------ */

  .ficha-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    translate: 100% 0;
    transition:
      translate 220ms var(--ease-cortina),
      display 220ms allow-discrete,
      overlay 220ms allow-discrete;
  }

  .ficha-panel[open] {
    translate: 0 0;
    transition:
      translate var(--duracion-panel) var(--ease-cortina),
      display var(--duracion-panel) allow-discrete,
      overlay var(--duracion-panel) allow-discrete;
  }

  @starting-style {
    .ficha-panel[open] {
      translate: 100% 0;
    }
  }

  .ficha-panel::backdrop {
    background-color: transparent;
  }

  :global(html:has(.ficha-panel[open])) {
    overflow: hidden;
  }

  /* Sin movimiento: la ficha aparece por opacidad, sin deslizarse. */
  @media (prefers-reduced-motion: reduce) {
    .ficha-panel,
    .ficha-panel[open] {
      translate: 0 0;
    }

    .ficha-panel {
      opacity: 0;
      transition: opacity 200ms linear, display 200ms allow-discrete, overlay 200ms allow-discrete;
    }

    .ficha-panel[open] {
      opacity: 1;
    }

    @starting-style {
      .ficha-panel[open] {
        opacity: 0;
        translate: 0 0;
      }
    }
  }

  .cerrar {
    position: relative;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--color-superficie);
    transition: rotate 240ms var(--ease-salida);
  }

  .cerrar::before,
  .cerrar::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1rem;
    height: 1.5px;
    background-color: var(--color-tinta);
    translate: -50% -50%;
    rotate: 45deg;
  }

  .cerrar::after {
    rotate: -45deg;
  }

  @media (hover: hover) and (pointer: fine) {
    .cerrar:hover {
      rotate: 90deg;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../lib/motion/gsap';

  const grilla = document.querySelector<HTMLElement>('[data-grilla]');
  const retratos = [...document.querySelectorAll<HTMLElement>('.retrato')];

  // --- Fichas ---------------------------------------------------------------

  for (const boton of document.querySelectorAll<HTMLButtonElement>('[data-abrir]')) {
    const ficha = document.getElementById(`ficha-${boton.dataset.abrir}`) as HTMLDialogElement | null;
    if (!ficha) continue;

    boton.addEventListener('click', () => ficha.showModal());
    ficha.querySelector('[data-cerrar]')?.addEventListener('click', () => ficha.close());
  }

  // --- Parallax -------------------------------------------------------------
  // Excepción aprobada por el cliente: la columna izquierda se desplaza más
  // rápido que la derecha. Solo escritorio y sin movimiento reducido.

  let parallax = gsap.matchMedia();

  const montarParallax = () => {
    parallax.revert();
    parallax = gsap.matchMedia();

    parallax.add('(min-width: 64rem) and (prefers-reduced-motion: no-preference)', () => {
      const izquierda = retratos.filter((r) => !r.hidden && r.dataset.lado === 'izq');
      for (const retrato of izquierda) {
        gsap.fromTo(
          retrato,
          { y: 150 },
          {
            y: -150,
            ease: 'none',
            scrollTrigger: { trigger: retrato, start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      }
    });
  };

  /** Tras filtrar, los visibles se reparten de nuevo entre las dos columnas. */
  const repartir = () => {
    retratos
      .filter((r) => !r.hidden)
      .forEach((retrato, i) => {
        retrato.dataset.lado = i % 2 === 0 ? 'izq' : 'der';
      });
    montarParallax();
    ScrollTrigger.refresh();
  };

  if (grilla) montarParallax();

  // --- Filtro por especialidad ---------------------------------------------

  const filtro = document.querySelector<HTMLElement>('[data-filtro]');
  const estado = document.querySelector<HTMLElement>('[data-filtro-estado]');

  if (filtro) {
    filtro.hidden = false;
    const botones = [...filtro.querySelectorAll<HTMLButtonElement>('button[data-area]')];

    for (const boton of botones) {
      boton.addEventListener('click', () => {
        const area = boton.dataset.area ?? '';
        let visibles = 0;

        for (const retrato of retratos) {
          const coincide = !area || (retrato.dataset.areas ?? '').split(' ').includes(area);
          retrato.hidden = !coincide;
          if (coincide) visibles += 1;
        }

        for (const otro of botones) otro.setAttribute('aria-pressed', String(otro === boton));
        if (estado) estado.textContent = `${visibles} ${visibles === 1 ? 'especialista' : 'especialistas'}`;
        repartir();
      });
    }
  }

  // --- Pestañas -------------------------------------------------------------

  const pestanas = document.querySelector<HTMLElement>('[data-pestanas]');
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];

  if (pestanas && tabs.length > 1) {
    pestanas.hidden = false;
    // Con pestañas, el titular del panel repite la pestaña: queda solo para lectores de pantalla.
    document.querySelector<HTMLElement>('[data-panel-apoyo]')?.classList.replace('mt-24', 'mt-12');
    document.querySelector<HTMLElement>('[data-titulo-apoyo]')?.classList.add('sr-only');

    const elegir = (tab: HTMLButtonElement, enfocar = false) => {
      for (const otro of tabs) {
        const activo = otro === tab;
        otro.setAttribute('aria-selected', String(activo));
        otro.tabIndex = activo ? 0 : -1;
        const panel = document.getElementById(otro.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !activo;
      }
      if (enfocar) tab.focus();
      ScrollTrigger.refresh();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => elegir(tab));
      tab.addEventListener('keydown', (evento) => {
        const paso = evento.key === 'ArrowRight' ? 1 : evento.key === 'ArrowLeft' ? -1 : 0;
        if (!paso) return;
        evento.preventDefault();
        elegir(tabs[(i + paso + tabs.length) % tabs.length]!, true);
      });
    });

    elegir(tabs[0]!);
  }
</script>
