---
import { getCollection } from 'astro:content';
import Seccion from '../ui/Seccion.astro';
import EncabezadoSeccion from '../ui/EncabezadoSeccion.astro';
import { SITIO } from '../../config/site';

// Los hitos sin año confirmado van al final, en su propio bloque: no se les
// inventa una fecha para que encajen en la secuencia.
const todos = await getCollection('hitos');
const fechados = todos
  .filter((hito) => hito.data.anio !== null)
  .sort((a, b) => (a.data.anio ?? 0) - (b.data.anio ?? 0));
const sinFecha = todos.filter((hito) => hito.data.anio === null);
---

<Seccion id="linea-de-tiempo">
  <EncabezadoSeccion
    titulo="Veinte años, contados en orden."
    entradilla={`De una consulta en ${SITIO.sede.ciudad} a un centro con seis especialidades.`}
    medida="12ch"
  />

  <div id="hitos" class="relative mt-12 border-t border-borde md:mt-16">
    <!-- En el margen, fuera de la columna de años. Sin JavaScript es una línea
         fija; con él se llena según avanza la lectura. -->
    <div class="absolute inset-y-0 -left-3 w-px bg-borde md:-left-5" aria-hidden="true">
      <div id="hitos-progreso" class="absolute -left-px h-full w-[3px] origin-top bg-verde"></div>
    </div>

    {
      fechados.map((hito) => (
        <article class="grid gap-x-10 gap-y-3 border-b border-borde py-8 md:grid-cols-12">
          <p class="anio cifra text-display md:col-span-4">{hito.data.anio}</p>

          <div class="md:col-span-7 md:col-start-6 md:self-center">
            <h3 class="text-subtitulo">{hito.data.titular}</h3>
            <p class="mt-2 max-w-[42ch] text-menor text-grafito">{hito.data.descripcion}</p>
          </div>
        </article>
      ))
    }
  </div>

  {
    sinFecha.length > 0 && (
      <div class="mt-10 max-w-texto">
        <h3 class="text-subtitulo">Reconocimientos y presencia en la región</h3>

        <ul class="mt-4">
          {sinFecha.map((hito) => (
            <li class="border-b border-borde py-4">
              <span class="block text-cuerpo">{hito.data.titular}</span>
              <span class="mt-1 block text-menor text-grafito">{hito.data.descripcion}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Seccion>

<style>
  /* El año que ya se leyó queda en tinta; los que faltan, en neblina. Solo se
     activa con JavaScript: sin él todos los años se ven en tinta. */
  .anio {
    transition: color var(--duracion-ui) var(--ease-salida);
  }

  [data-seguimiento] .anio:not(.es-leido) {
    color: var(--color-neblina);
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/motion/gsap';

  const hitos = document.getElementById('hitos');
  const progreso = document.getElementById('hitos-progreso');

  if (hitos && progreso) {
    gsap.context(() => {
      const mm = gsap.matchMedia();

      // Con movimiento reducido no hay seguimiento: la línea queda llena y
      // todos los años en tinta, como sin JavaScript.
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        hitos.dataset.seguimiento = '';

        // Lineal a propósito: la barra es el scroll mismo, no una animación
        // con curva. Cualquier easing la despegaría del dedo.
        gsap.fromTo(
          progreso,
          { scaleY: 0 },
          {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: { trigger: hitos, start: 'top 70%', end: 'bottom 70%', scrub: true },
          },
        );

        for (const anio of hitos.querySelectorAll('.anio')) {
          ScrollTrigger.create({
            trigger: anio,
            start: 'top 70%',
            onEnter: () => anio.classList.add('es-leido'),
            onLeaveBack: () => anio.classList.remove('es-leido'),
          });
        }

        return () => delete hitos.dataset.seguimiento;
      });
    }, hitos);
  }
</script>
