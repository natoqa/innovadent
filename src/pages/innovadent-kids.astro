---
import { getCollection, getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';
import Boton from '../components/ui/Boton.astro';
import EspacioFoto from '../components/ui/EspacioFoto.astro';
import { SITIO } from '../config/site';

export const prerender = true;

// Kids es el ámbito de marca de odontopediatría: el texto es el que el cliente
// escribió para esa especialidad, no uno paralelo que haya que mantener.
const odontopediatria = await getEntry('tratamientos', 'odontopediatria');
if (!odontopediatria) throw new Error('Innovadent Kids necesita el tratamiento odontopediatria.');
const t = odontopediatria.data;

const idsEquipo = new Set(t.especialistas.map((ref) => ref.id));
const odontopediatras = (
  await getCollection('especialistas', ({ id }) => idsEquipo.has(id))
).sort((a, b) => a.data.orden - b.data.orden);

const fotos = (await getCollection('kids')).sort((a, b) => a.data.orden - b.data.orden);

/**
 * Los huecos de foto de la página, en orden de aparición. Las fotos de la
 * colección kids los van ocupando según su `orden`; los que quedan vacíos se
 * ven en gris con la foto que falta.
 */
const hueco = (i: number, descripcion: string) => ({
  descripcion,
  imagen: fotos[i]?.data.foto,
  alt: fotos[i]?.data.alt,
});

const portada = hueco(0, 'Foto principal: un niño en consulta con la odontopediatra.');
const detalle = hueco(1, 'Detalle: manos del niño y de la odontopediatra, o el cepillo.');
const bienvenida = hueco(
  2,
  'Foto horizontal de la bienvenida: el niño y sus padres con la odontopediatra antes de empezar.',
);
const galeria = [
  hueco(3, 'Espacio donde se atiende a los niños, vista general.'),
  hueco(4, 'La odontopediatra enseñando la técnica de cepillado.'),
  hueco(5, 'Los padres acompañando la consulta.'),
  hueco(6, 'El niño al terminar la consulta.'),
];

const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<Base
  titulo={`Innovadent Kids, odontopediatría en ${SITIO.sede.ciudad}`}
  descripcion={t.seo.descripcion}
  ruta="/innovadent-kids"
>
  <Nav slot="encabezado" ruta="/innovadent-kids" />

  {/* Portada: titular a la izquierda y dos fotos superpuestas a la derecha. */}
  <section class="kids overflow-hidden pt-32 pb-seccion md:pt-40">
    <div class="mx-auto grid max-w-ancho gap-x-16 gap-y-14 px-6 md:grid-cols-12 md:items-center md:px-10">
      <div class="md:col-span-6">
        <p class="text-menor">Innovadent Kids</p>
        <h1 class="mt-4 max-w-[13ch] text-display">{t.titular}</h1>
        <p class="mt-6 max-w-[38ch] text-cuerpo-lg">{t.resumen}</p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <Boton href="/#reserva">Reservar mi cita</Boton>
          <Boton href={`/tratamientos/${odontopediatria.id}`} variante="secundaria">
            Ver odontopediatría
          </Boton>
        </div>
      </div>

      <div class="relative md:col-span-6 md:pb-20">
        <EspacioFoto
          {...portada}
          aspecto="aspect-[4/5]"
          sizes="(min-width: 768px) 38vw, 85vw"
          prioritaria
          class="w-[85%] md:w-[78%]"
        />
        <div class="absolute right-0 bottom-0 w-[46%] translate-y-1/3 rounded-[calc(var(--radius-foto)+6px)] bg-verde-100 p-1.5 md:w-[42%] md:translate-y-0">
          <EspacioFoto {...detalle} aspecto="aspect-square" sizes="(min-width: 768px) 20vw, 45vw" />
        </div>
      </div>
    </div>
  </section>

  {/* Qué es: el texto del cliente a tamaño de entradilla, y la primera visita aparte. */}
  <Seccion ritmo="corto">
    <div class="grid gap-x-16 gap-y-12 md:grid-cols-12">
      <p class="text-subtitulo md:col-span-7">{t.problema}</p>

      <aside class="kids self-start p-6 md:col-span-4 md:col-start-9 md:p-8">
        <h2 class="text-cuerpo-lg font-semibold">Cuándo hacer la primera visita</h2>
        <p class="mt-3 text-cuerpo">{t.indicaciones}</p>
      </aside>
    </div>
  </Seccion>

  {/* Motivos de consulta en tipografía grande; los cuidados, como etiquetas. */}
  <Seccion tono="franja">
    <div class="grid gap-x-16 gap-y-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 class="max-w-[12ch] text-display">Qué atendemos</h2>
      </div>

      <ul class="md:col-span-7">
        {
          t.atendemos.map((motivo) => (
            <li class="border-t border-borde py-5 text-titulo last:border-b">
              {motivo.replace(/\.$/, '')}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-16 grid gap-x-16 gap-y-6 md:grid-cols-12">
      <h3 class="text-cuerpo-lg md:col-span-5">Prevención y tratamiento</h3>

      <ul class="flex flex-wrap gap-2 md:col-span-7">
        {
          t.alternativas.map((cuidado) => (
            <li class="bg-superficie px-4 py-2.5 text-menor">{cuidado}</li>
          ))
        }
      </ul>
    </div>
  </Seccion>

  {/* Primera visita: una foto ancha y los pasos colgados de un eje. */}
  <Seccion>
    <h2 class="max-w-[14ch] text-display">Cómo es la primera visita</h2>

    <EspacioFoto
      {...bienvenida}
      aspecto="aspect-[4/3] md:aspect-[21/9]"
      sizes="(min-width: 1248px) 1200px, 100vw"
      class="mt-12"
    />

    <ol class="mt-12 grid gap-10 md:grid-cols-4 md:gap-6">
      {
        t.proceso.map((paso, i) => (
          <li class="paso">
            <span class="eje" aria-hidden="true" />
            <p class="cifra mt-4 text-menor text-verde-700">{numero(i)}</p>
            <h3 class="mt-1 text-subtitulo">{paso.titulo}</h3>
            <p class="mt-3 text-cuerpo text-grafito">{paso.descripcion}</p>
          </li>
        ))
      }
    </ol>
  </Seccion>

  {/* Equipo: texto y recursos a la izquierda, retratos escalonados a la derecha. */}
  <Seccion tono="kids">
    <div class="grid gap-x-16 gap-y-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <h2 class="max-w-[14ch] text-display">Un equipo que sabe tratar con niños</h2>
        {t.equipo && <p class="mt-6 text-cuerpo-lg">{t.equipo}</p>}

        {
          t.tecnologia.length > 0 && (
            <>
              <h3 class="mt-12 text-cuerpo font-semibold">Recursos para la atención</h3>
              <ul class="mt-4 border-t border-verde-700/40">
                {t.tecnologia.map((recurso) => (
                  <li class="border-b border-verde-700/40 py-4 text-cuerpo">{recurso}</li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      {
        odontopediatras.length > 0 && (
          <ul class="grid grid-cols-2 gap-4 self-start md:col-span-6 md:col-start-7 md:gap-8">
            {odontopediatras.map((persona, i) => (
              <li class:list={[i % 2 === 1 && 'mt-16 md:mt-28']}>
                <div class="foto aspect-[3/4] bg-tinta-800">
                  {persona.data.retrato && (
                    <Picture
                      src={persona.data.retrato}
                      alt={`Retrato de ${persona.data.nombre}.`}
                      formats={['avif', 'webp']}
                      widths={[320, 480, 720]}
                      sizes="(min-width: 768px) 24vw, 45vw"
                      loading="lazy"
                      class="h-full w-full object-cover object-[50%_22%]"
                    />
                  )}
                </div>
                <p class="mt-4 text-cuerpo font-semibold hyphens-none">{persona.data.nombre}</p>
                <p class="mt-1 text-menor">{persona.data.especialidad}</p>
                <p class="cifra mt-1 text-menor">Colegiatura {persona.data.colegiatura}</p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Seccion>

  {/* Galería en mosaico: tamaños distintos, no una grilla de iguales. */}
  <Seccion ritmo="corto">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
      <h2 class="text-titulo">Así es la atención</h2>
      <p class="max-w-[40ch] text-menor text-grafito">
        Publicamos fotos de niños solo con la autorización firmada de sus padres.
      </p>
    </div>

    <div class="mosaico mt-10 grid grid-cols-2 gap-4 md:grid-cols-12 md:gap-6">
      {
        galeria.map((foto, i) => (
          <EspacioFoto
            {...foto}
            aspecto={['aspect-[4/5] md:aspect-auto md:h-full', 'aspect-[4/5]', 'aspect-[4/5]', 'aspect-[4/5] md:aspect-[16/10]'][i]}
            sizes={i === 0 ? '(min-width: 768px) 45vw, 50vw' : '(min-width: 768px) 30vw, 50vw'}
            class={['md:col-span-5 md:row-span-2', 'md:col-span-3', 'md:col-span-4', 'col-span-2 md:col-span-7'][i]}
          />
        ))
      }
    </div>
  </Seccion>

  <Seccion tono="oscuro">
    <div class="grid gap-x-16 gap-y-10 md:grid-cols-12 md:items-end">
      {t.cierre && <p class="max-w-[18ch] text-display md:col-span-8">{t.cierre}</p>}

      <div class="md:col-span-3 md:col-start-10">
        <Boton href="/#reserva">Reservar mi cita</Boton>
      </div>
    </div>
  </Seccion>
  <Pie slot="pie" />
</Base>

<style>
  /* Eje de la primera visita: punto por paso y línea hasta el siguiente. */
  .eje {
    display: flex;
    align-items: center;
  }

  .eje::before {
    content: '';
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: var(--color-verde);
  }

  .eje::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-borde);
  }

  @media (min-width: 48rem) {
    .eje::after {
      margin-right: -1.5rem;
    }

    .paso:last-child .eje::after {
      visibility: hidden;
    }
  }
</style>
