---
import Seccion from '../ui/Seccion.astro';
import Ficha, { type Fila } from '../ui/Ficha.astro';
import Boton from '../ui/Boton.astro';
import { SITIO } from '../../config/site';

const { sede, horarios } = SITIO;
const { whatsapp, whatsappTexto } = SITIO.contacto;

const direccion = `${sede.calle}, ${sede.distrito}, ${sede.ciudad}`;

// Sin la ficha de Google Maps se abre una búsqueda de la dirección real: lleva
// al mismo sitio sin inventar coordenadas.
const enlaceMapa =
  sede.mapa ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${direccion}, ${sede.region}, ${sede.pais}`)}`;

const filas: Fila[] = [
  ...horarios
    .filter((horario) => horario.apertura && horario.cierre)
    .map((horario) => ({ etiqueta: horario.dias, valor: `${horario.apertura} a ${horario.cierre}` })),
  ...(sede.estacionamiento === null
    ? []
    : [{ etiqueta: 'Estacionamiento', valor: sede.estacionamiento ? 'Disponible' : 'No disponible' }]),
];
---

<Seccion id="sede" tono="franja" ritmo="corto">
  <div class="grid gap-x-16 gap-y-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <h2 class="text-display">Cómo llegar.</h2>

      <address class="mt-6 text-subtitulo not-italic">
        {sede.calle}<br />
        {sede.distrito}<br />
        {sede.ciudad}, {sede.region}
      </address>

      <div class="mt-8">
        <Ficha filas={filas} titulo="Horario de atención y estacionamiento" />
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <Boton href={enlaceMapa} target="_blank" rel="noopener">Abrir en Google Maps</Boton>
        {
          whatsapp && (
            <Boton href={`https://wa.me/${whatsapp}`} variante="secundaria" target="_blank" rel="noopener">
              WhatsApp {whatsappTexto}
            </Boton>
          )
        }
      </div>
    </div>

    <div class="md:col-span-7">
      <div class="foto aspect-[4/3] bg-tinta-800">
        <div class="flex h-full items-center justify-center p-6">
          <span class="max-w-[36ch] text-center text-dato text-superficie">
            [PENDIENTE: fotografía de la fachada en {sede.calle}. El mapa embebido se
            añade cuando la clínica entregue el enlace de su ficha de Google Maps.]
          </span>
        </div>
      </div>
    </div>
  </div>
</Seccion>
