---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Seccion from '../ui/Seccion.astro';
import { SITIO } from '../../config/site';
import fotoEquipo from '../../assets/equipo/especialistas-innovadent.jpg';
import fotoEspecialistas from '../../assets/equipo/especialistas-innovadent-2.jpg';

const anios = SITIO.aniversario - SITIO.fundacion;
const pacientes = new Intl.NumberFormat(SITIO.idioma).format(SITIO.pacientes);

// Dos fotos del equipo actual, en color: el gris estaba pensado para una foto
// de archivo y aquí haría pasar por antiguas fotos de hoy.
const fotos = [
  {
    proporcion: 'aspect-[4/5]',
    desplazada: false,
    gris: false,
    imagen: fotoEquipo,
    alt: 'Seis integrantes del equipo de Innovadent con uniforme negro, riendo juntos alrededor de un sillón dental en una de las salas clínicas.',
    marcador: '',
    pie: 'Equipo de Innovadent en una de las salas clínicas.',
  },
  {
    proporcion: 'aspect-[3/4]',
    desplazada: true,
    gris: false,
    imagen: fotoEspecialistas,
    alt: 'Seis especialistas de Innovadent con uniforme negro, sonriendo juntos alrededor de un sillón dental en una sala clínica: tres sentados delante y tres de pie detrás.',
    marcador: '',
    pie: 'Especialistas de Innovadent en una de las salas clínicas.',
  },
];

// Solo cifras verificables: los años salen de site.ts, las especialidades de
// la colección de tratamientos, el premio está en la colección de hitos y el
// total de pacientes lo entregó la clínica. Ninguna se estima.
const especialidades = (await getCollection('tratamientos')).length;
---

<Seccion id="manifiesto" ritmo="corto">
  <div class="grid gap-x-10 gap-y-8 md:grid-cols-12">
    <h2 class="text-display md:col-span-7" data-mov="titulo">Calidad y ética en cada tratamiento.</h2>

    <div class="md:col-span-4 md:col-start-9 md:self-end" data-mov="texto">
      <p class="text-cuerpo">
        Una buena odontología no se trata solamente de hacer un buen trabajo clínico.
        Se trata de indicar lo que el paciente realmente necesita, explicar con
        transparencia sus alternativas y cuidar su salud como si fuera la nuestra.
      </p>
    </div>
  </div>

  <div class="mt-10 max-w-texto" data-mov="texto">
    <p class="text-cuerpo-lg">
      Innovadent nació en {SITIO.fundacion} con un propósito claro: brindar a la comunidad
      trujillana una atención odontológica especializada, cercana y comprometida con las
      personas.
    </p>

    <p class="mt-5 text-cuerpo">
      Desde los primeros años apostamos por la atención odontopediátrica y, con el
      tiempo, fuimos incorporando nuevas especialidades, profesionales y tecnología para
      responder a las necesidades de cada paciente. {anios} años después seguimos
      evolucionando con la misma esencia con la que comenzamos.
    </p>
  </div>

  <div class="mt-16 grid gap-6 md:grid-cols-2 md:items-end" data-mov-fotos>
    {
      fotos.map((foto) => (
        <figure
          class:list={[foto.desplazada && 'md:mb-16']}
          data-mov={foto.desplazada ? 'profundidad' : undefined}
          data-mov-intensidad="50"
        >
          <div class:list={['foto bg-tinta-800', foto.proporcion, foto.gris && 'grayscale']}>
            {foto.imagen ? (
              <Picture
                src={foto.imagen}
                alt={foto.alt}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200]}
                width={1200}
                sizes="(min-width: 768px) 45vw, 100vw"
                loading="lazy"
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full items-center justify-center p-6">
                <span class="text-center text-dato text-superficie">{foto.marcador}</span>
              </div>
            )}
          </div>

          <figcaption class="mt-3 text-menor text-grafito">{foto.pie}</figcaption>
        </figure>
      ))
    }
  </div>

</Seccion>

<!-- Excepción aprobada por el cliente: tercera zona oscura de la home. -->
<Seccion tono="oscuro" ritmo="corto" etiquetaAccesible="Innovadent en cifras">
  <div data-cifras data-idioma={SITIO.idioma}>
    <div class="pb-10 md:pb-14">
      <span class="sr-only">{pacientes}</span>
      <span class="cifra block font-light text-cifra-mayor" data-contar={SITIO.pacientes} aria-hidden="true">
        {pacientes}
      </span>
      <p class="mt-5 text-subtitulo">Pacientes atendidos desde {SITIO.fundacion}</p>
    </div>

    <div class="grid grid-cols-2 border-t border-tinta-700 md:grid-cols-12" data-mov="filas" data-mov-retraso="0.3">
      <div class="border-r border-tinta-700 py-8 pr-6 md:col-span-4 md:py-10 md:pr-10">
        <span class="sr-only">{anios}</span>
        <span class="cifra block font-light text-display" data-contar={anios} aria-hidden="true">{anios}</span>
        <p class="mt-3 text-menor text-superficie/75">Años de ejercicio continuo en {SITIO.sede.ciudad}</p>

        <div class="mt-6 flex items-center gap-3 text-dato text-superficie/75" aria-hidden="true">
          <span class="cifra">{SITIO.fundacion}</span>
          <span class="relative h-px flex-1 bg-tinta-700">
            <span class="absolute inset-0 origin-left bg-verde-200" data-trazo></span>
          </span>
          <span class="cifra">{SITIO.aniversario}</span>
        </div>
      </div>

      <div class="py-8 pl-6 md:col-span-3 md:border-r md:border-tinta-700 md:px-10 md:py-10">
        <span class="sr-only">{especialidades}</span>
        <span class="cifra block font-light text-display" data-contar={especialidades} aria-hidden="true">
          {especialidades}
        </span>
        <p class="mt-3 text-menor text-superficie/75">Especialidades bajo una misma visión</p>
      </div>

      <div class="col-span-2 border-t border-tinta-700 py-8 md:col-span-5 md:border-t-0 md:py-10 md:pl-10">
        <span class="cifra block font-light text-display text-verde-200">2011</span>
        <h3 class="mt-3 text-subtitulo">Premio Presidente a la MYPE</h3>
        <p class="mt-2 text-menor text-superficie/75">
          Un reconocimiento que nos permitió conocer nuevas realidades y experiencias en São Paulo, Brasil.
        </p>
      </div>
    </div>
  </div>
</Seccion>

<script>
  import { gsap } from '../../lib/motion/gsap';

  const banda = document.querySelector<HTMLElement>('[data-cifras]');

  if (banda) {
    const formato = new Intl.NumberFormat(banda.dataset.idioma);
    const numeros = [...banda.querySelectorAll<HTMLElement>('[data-contar]')];
    const trazo = banda.querySelector<HTMLElement>('[data-trazo]');

    gsap.context(() => {
      const mm = gsap.matchMedia();

      // Con movimiento reducido las cifras quedan como vienen del servidor.
      // Sin JavaScript, igual: el conteo solo existe si puede terminar.
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        for (const [i, numero] of numeros.entries()) {
          const final = Number(numero.dataset.contar);
          const estado = { valor: 0 };

          // Arranca en cero ya al preparar el efecto: si esperara al disparo,
          // la cifra final se vería un instante y luego saltaría a cero.
          numero.textContent = formato.format(0);

          // Las cifras son tabulares: el ancho no cambia mientras suben.
          gsap.to(estado, {
            valor: final,
            duration: 1.2,
            delay: i * 0.08,
            onUpdate: () => {
              numero.textContent = formato.format(Math.round(estado.valor));
            },
            scrollTrigger: { trigger: banda, start: 'top 85%', once: true },
          });
        }

        // La línea 2006–2026 se dibuja al ritmo de los años.
        if (trazo) {
          gsap.from(trazo, {
            scaleX: 0,
            duration: 1.2,
            scrollTrigger: { trigger: banda, start: 'top 85%', once: true },
          });
        }

        return () => {
          for (const numero of numeros) {
            numero.textContent = formato.format(Number(numero.dataset.contar));
          }
        };
      });
    }, banda);
  }
</script>
