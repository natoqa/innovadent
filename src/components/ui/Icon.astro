---
/**
 * Iconos del sitio. SVG inline, sin dependencias: cada glifo vive aquí.
 * Siempre decorativo — el nombre accesible lo pone el elemento que lo contiene.
 *
 * Los de control (pausa, reproducir) y los logotipos de redes son rellenos;
 * los de especialidad son de trazo, para que a tamaño pequeño se lean como dibujo técnico y no como mancha.
 */
type Relleno = 'pausa' | 'reproducir' | 'whatsapp' | 'instagram' | 'tiktok';
type Trazo =
  | 'ortodoncia'
  | 'endodoncia'
  | 'implante'
  | 'corona'
  | 'cirugia'
  | 'diente-infantil'
  | 'cerrar';
type Nombre = Relleno | Trazo;

interface Props {
  nombre: Nombre;
  tamano?: number;
  class?: string;
}

const { nombre, tamano = 20, class: clase } = Astro.props;

const rellenos: Nombre[] = ['pausa', 'reproducir', 'whatsapp', 'instagram', 'tiktok'];
const deTrazo = !rellenos.includes(nombre);

