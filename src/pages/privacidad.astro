---
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Pie from '../components/layout/Pie.astro';
import Seccion from '../components/ui/Seccion.astro';

export const prerender = true;

/**
 * El texto legal lo redacta y firma la clínica: responsable del banco de
 * datos, su inscripción ante la ANPDP, finalidades, destinatarios y cómo
 * ejercer los derechos ARCO. Aquí no se redacta por aproximación.
 * Debe cubrir la Ley 29733: responsable e inscripción del banco de datos,
 * finalidad, transferencia al sistema de gestión de pacientes, plazo de
 * conservación y ejercicio de los derechos ARCO.
 */
---

<Base titulo="Política de privacidad" ruta="/privacidad" noIndexar>
  <Nav slot="encabezado" />

  <Seccion ancho="texto" class="pt-40">
    <h1 class="text-display">Política de privacidad</h1>

    <p class="mt-8 text-cuerpo-lg">Este texto está en preparación.</p>
  </Seccion>

  <Pie slot="pie" />
</Base>
